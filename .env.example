# Agent 大脑：claude（默认）、deepseek 或 gpt。与下面的图像通道独立选择。
AGENT_PROVIDER=claude

# 1. Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# 2. DeepSeek：选择 AGENT_PROVIDER=deepseek 后只需 DeepSeek key，无需 Claude key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 必须使用 Anthropic 兼容地址（不是 OpenAI 的 /v1 地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_EFFORT=high
# low / high / max；deepseek-flash 支持视觉，deepseek-v4-pro 不支持。
AGENT_MAX_TURNS=40

# 3. GPT：AGENT_PROVIDER=gpt；选择 API key 或 ChatGPT 订阅登录。
# api_key：使用下方 OPENAI_API_KEY，按 API 用量单独计费（Plus 不抵扣）。
# chatgpt：启动后点击页面 Continue with ChatGPT；使用官方 OAuth，令牌存于 DATA_DIR/auth/chatgpt.json。
GPT_AUTH_MODE=api_key
GPT_MODEL=gpt-6.1-sol
GPT_EFFORT=medium
# 仅 API key 模式支持覆盖地址；订阅模式固定使用官方 Responses API。
GPT_BASE_URL=https://api.openai.com/v1

# Node 不自动继承 Windows/v2rayN 的系统代理。按本机客户端的 HTTP/Mixed 端口填写，重启后生效。
# 需提供 http.setGlobalProxyFromEnv 的 Node 版本（本机 Node 24.15.0 已验证）；影响所有 Node HTTP/HTTPS/SDK 出站请求。
# 例如 v2rayN 的 HTTP/Mixed 端口为 10808 时，使用 http://127.0.0.1:10808（不是 socks://）。
HTTP_PROXY=
HTTPS_PROXY=
# 服务会始终保留 loopback 绕过，避免项目页面与 OAuth 本机回调走外部代理。
NO_PROXY=localhost,127.0.0.1,::1


# 图像模型（至少配置一个；都不配时只能用 Mock 占位图）
# 默认通道：留空自动选择，或 openai / gemini / seedream / sdwebui / codex_image / chatgpt_manual / mock
IMAGE_PROVIDER=

# 1. OpenAI API key
OPENAI_API_KEY=
# API 通道可指定 Flare（速度）或 Sunburst（质量），需要 API key 并单独计费。
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# 2. Gemini API key
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 3. 火山方舟 Seedream（不需要 OpenAI / Gemini 图像 key）
ARK_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 1K / 1.5K / 2K；按素材横竖比例或精灵帧数映射成合法像素尺寸。
SEEDREAM_SIZE=2K
SEEDREAM_WATERMARK=false
# 默认直接返回 Base64；也可选 url，服务端会立即下载到本地。
SEEDREAM_RESPONSE_FORMAT=b64_json

# 4. 本地 Stable Diffusion WebUI（AUTOMATIC1111 / Forge，需以 --api 启动）
SD_WEBUI_URL=
# 可选：SD_API_AUTH=user:pass、SD_CHECKPOINT、SD_SIZE=1024（SD1.5 用 512）、SD_STEPS、SD_CFG、SD_SAMPLER、SD_NEGATIVE_PROMPT
# 参考图风格迁移需要 ControlNet + IP-Adapter：SD_IPADAPTER_MODEL=<模型名>、SD_IPADAPTER_MODULE、SD_IPADAPTER_WEIGHT=0.7
SD_IPADAPTER_MODEL=

# 5. 本机 Codex 内置 imagegen（使用 Codex 自身的 ChatGPT 订阅登录，不使用项目 OAuth 或 API key）
CODEX_IMAGE_ENABLED=false
CODEX_IMAGE_BIN=codex
# Windows 上会显式指定 Codex 的 unelevated 沙箱；缺省沙箱会拦截 worker 执行的命令，导致图片复制不到 asset.png。
# 可选：独立 CLI 配置/凭证目录；留空使用 Codex 默认位置。服务运行账号需要先执行 codex login。
CODEX_IMAGE_HOME=
CODEX_IMAGE_AUTH_MODE=chatgpt
# 当前内置工具没有生图模型参数，只支持 auto；Flare/Sunburst 请使用上方 API 配置。
CODEX_IMAGE_VARIANT=auto
# 可选：执行生图任务的语言模型，不是图像模型。
CODEX_IMAGE_AGENT_MODEL=gpt-6.1-sol
CODEX_IMAGE_TIMEOUT_MS=300000
CODEX_IMAGE_CONCURRENCY=1
# 默认失败即停止；显式选择 seedream 会消耗方舟额度，chatgpt_manual 会转为人工接力。
CODEX_IMAGE_FALLBACK=none

# 人工接力：导出提示词和参考图，在 ChatGPT 生图后上传结果继续审核。
MANUAL_IMAGE_ENABLED=false
MANUAL_IMAGE_TIMEOUT_MS=86400000
# IMAGE_PROVIDER=codex_image 或 chatgpt_manual 会直接启用对应通道，无需再设置 ENABLED。

# 图像接口遇到 429 / 5xx / 网络错误时的重试次数（指数退避，遵循 Retry-After）
IMAGE_MAX_RETRIES=3

# 用量面板的费用估算。Claude / DeepSeek Flash 内置官方单价；DeepSeek 按峰时价估算。
# 覆盖对应服务商价格时，填「输入,输出,缓存写,缓存读」美元/百万 tokens。
CLAUDE_PRICE=
DEEPSEEK_PRICE=
GPT_PRICE=
# 图像单价（美元/张），不填则只统计调用次数
IMAGE_PRICE_OPENAI=
IMAGE_PRICE_GEMINI=
# 费用面板使用美元/张；留空只统计调用次数，勿直接填写人民币价格。
IMAGE_PRICE_SEEDREAM=

# 访问令牌：设置后打开页面需先输入它登录（公网部署务必设置）；API 也可用 Authorization: Bearer <令牌>
ACCESS_TOKEN=
# 同一 IP 10 分钟内登录失败的次数上限；在反向代理后面时设置 TRUST_PROXY（如 1 或 loopback）以识别真实客户端 IP
LOGIN_MAX_ATTEMPTS=10
TRUST_PROXY=

# 单次运行预算默认值（界面里可按次覆盖；不填为不限）：图像调用次数上限、估算费用上限（美元）
RUN_MAX_IMAGES=40
RUN_MAX_USD=

# 删除的素材在回收站保留的天数（之后彻底删除）
TRASH_DAYS=7

# demo = 不调用 Agent 模型，用脚本跑一遍流水线（用于无 key 时体验界面）
AGENT_MODE=
PORT=5173
