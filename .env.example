# Agent 大脑：claude（默认）、deepseek 或 gpt。与下面的图像通道独立选择。
AGENT_PROVIDER=claude
# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# DeepSeek：选择 AGENT_PROVIDER=deepseek 后只需 DeepSeek key，无需 Claude key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 必须使用 Anthropic 兼容地址（不是 OpenAI 的 /v1 地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_EFFORT=high
# low / high / max；deepseek-flash 支持视觉，deepseek-v4-pro 不支持。
AGENT_MAX_TURNS=40

# GPT：AGENT_PROVIDER=gpt；选择 API key 或 ChatGPT 订阅登录。
# api_key：使用下方 OPENAI_API_KEY，按 API 用量单独计费（Plus 不抵扣）。
# chatgpt：启动后点击页面 Continue with ChatGPT；使用官方 OAuth，令牌存于 DATA_DIR/auth/chatgpt.json。
GPT_AUTH_MODE=api_key
GPT_MODEL=gpt-6.1-sol
GPT_EFFORT=medium
# 仅 API key 模式支持覆盖地址；订阅模式固定使用官方 Responses API。
GPT_BASE_URL=https://api.openai.com/v1

# 图像模型（至少配置一个；都不配时只能用 Mock 占位图）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# 火山方舟 Seedream（不需要 OpenAI / Gemini 图像 key）
ARK_API_KEY=
SEEDREAM_MODEL=doubao-seedream-5-0-flash-260915
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 1K / 1.5K / 2K；按素材横竖比例或精灵帧数映射成合法像素尺寸。
SEEDREAM_SIZE=2K
SEEDREAM_WATERMARK=false
# 默认直接返回 Base64；也可选 url，服务端会立即下载到本地。
SEEDREAM_RESPONSE_FORMAT=b64_json
# 本地 Stable Diffusion WebUI（AUTOMATIC1111 / Forge，需以 --api 启动）
SD_WEBUI_URL=
# 可选：SD_API_AUTH=user:pass、SD_CHECKPOINT、SD_SIZE=1024（SD1.5 用 512）、SD_STEPS、SD_CFG、SD_SAMPLER、SD_NEGATIVE_PROMPT
# 参考图风格迁移需要 ControlNet + IP-Adapter：SD_IPADAPTER_MODEL=<模型名>、SD_IPADAPTER_MODULE、SD_IPADAPTER_WEIGHT=0.7
SD_IPADAPTER_MODEL=

# 图像接口遇到 429 / 5xx / 网络错误时的重试次数（指数退避，遵循 Retry-After）
IMAGE_MAX_RETRIES=3

# 用量面板的费用估算。Claude / DeepSeek Flash 内置官方单价；DeepSeek 按峰时价估算。
# 覆盖对应服务商价格时，填「输入,输出,缓存写,缓存读」美元/百万 tokens。
CLAUDE_PRICE=
DEEPSEEK_PRICE=
GPT_PRICE=
# 图像单价（美元/张），不填则只统计调用次数
IMAGE_PRICE_OPENAI=
IMAGE_PRICE_GEMINI=
# 费用面板使用美元/张；留空只统计调用次数，勿直接填写人民币价格。
IMAGE_PRICE_SEEDREAM=

# 访问令牌：设置后打开页面需先输入它登录（公网部署务必设置）；API 也可用 Authorization: Bearer <令牌>
ACCESS_TOKEN=
# 同一 IP 10 分钟内登录失败的次数上限；在反向代理后面时设置 TRUST_PROXY（如 1 或 loopback）以识别真实客户端 IP
LOGIN_MAX_ATTEMPTS=10
TRUST_PROXY=

# 单次运行预算默认值（界面里可按次覆盖；不填为不限）：图像调用次数上限、估算费用上限（美元）
RUN_MAX_IMAGES=40
RUN_MAX_USD=

# 删除的素材在回收站保留的天数（之后彻底删除）
TRASH_DAYS=7

# demo = 不调用 Agent 模型，用脚本跑一遍流水线（用于无 key 时体验界面）
AGENT_MODE=
PORT=5173
